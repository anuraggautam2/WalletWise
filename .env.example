# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/walletwise?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/walletwise

# JWT Secret & Expiration
JWT_SECRET=walletwise_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173
